{
  "manifest_version": 3,
  "name": "AFFILIATE PRO — Google Flow & Meta AI TikTok Automation",
  "version": "2.0.0",
  "description": "ระบบสร้างวิดีโอคลิป Affiliate อัตโนมัติผ่าน Google Flow และ Meta AI พร้อมโพสต์ ปักตะกร้าสินค้า และเปิดป้าย AI บน TikTok Studio",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://*.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/*"
      ],
      "js": ["flow_driver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"],
      "js": ["meta_driver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://shop.tiktok.com/*"
      ],
      "js": ["tiktok_driver.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "เปิด AFFILIATE PRO"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
