{
  "manifest_version": 3,
  "name": "TikTok AI Studio — Flow & Meta AI",
  "version": "1.0.0",
  "description": "สร้างภาพและวิดีโอ 9:16 จากสินค้า TikTok Showcase อัตโนมัติด้วย Google Flow & Meta AI พร้อมปักตะกร้า",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://flow-content.google/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://*.tiktok.com/*",
    "https://shop.tiktok.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flow.google.com/*",
        "https://labs.google/fx/tools/flow/*",
        "https://labs.google/*"
      ],
      "js": ["flow_driver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meta.ai/*", "https://meta.ai/*"],
      "js": ["meta_driver.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["tiktok_driver.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "เปิด TikTok AI Studio"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
